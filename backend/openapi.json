  "components": {
    "schemas": {
      "AnalysisExtractRequest": {
        "properties": {
          "document_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Document Ids",
            "description": "List of document IDs to extract parameters from"
          }
        },
        "type": "object",
        "required": [
          "document_ids"
        ],
        "title": "AnalysisExtractRequest"
      },
      "Body_upload_documents_api_v1_documents_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files",
            "description": "Multipart file upload field accepting multiple scientific papers/datasets"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_upload_documents_api_v1_documents_post"
      },
      "CitationResponse": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "document_title": {
            "type": "string",
            "title": "Document Title"
          },
          "page_number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Number"
          },
          "quote": {
            "type": "string",
            "title": "Quote"
          },
          "verified": {
            "type": "boolean",
            "title": "Verified"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "document_id",
          "document_title",
          "page_number",
          "quote",
          "verified"
        ],
        "title": "CitationResponse"
      },
      "DocumentSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "file_type": {
            "type": "string",
            "title": "File Type"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "progress": {
            "type": "number",
            "title": "Progress"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "chunk_count": {
            "type": "integer",
            "title": "Chunk Count"
          },
          "uploaded_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Uploaded At"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "filename",
          "file_type",
          "size_bytes",
          "status",
          "progress",
          "chunk_count"
        ],
        "title": "DocumentSummary"
      },
      "DocumentUploadBatchResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "total_files": {
            "type": "integer",
            "title": "Total Files"
          },
          "successful_count": {
            "type": "integer",
            "title": "Successful Count"
          },
          "failed_count": {
            "type": "integer",
            "title": "Failed Count"
          },
          "documents": {
            "items": {
