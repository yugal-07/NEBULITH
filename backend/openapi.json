    "/api/v1/documents": {
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Upload Documents",
        "description": "Upload one or more scientific documents (PDF, DOCX, CSV, XLSX).\nField name: 'files'.\nReturns a per-file result list so one bad file does not fail the batch.",
        "operationId": "upload_documents_api_v1_documents_post",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_documents_api_v1_documents_post"
