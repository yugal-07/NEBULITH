# NEBULITH Environment Configuration

# Server
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001

# Database (PostgreSQL with pgvector for production; SQLite for local dev)
# PostgreSQL: postgresql+psycopg2://nebulith:nebulith@localhost:5432/nebulith
DATABASE_URL=sqlite:///./backend/data/nebulith.db

# File Storage
UPLOAD_DIR=./backend/storage/uploads
MAX_UPLOAD_SIZE_MB=50

# Providers: 'local', 'mock', 'openai', 'gemini'
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# API Keys (leave blank when LLM_PROVIDER=mock)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Ingestion Parameters
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100

# Geospatial Screening
GRID_RESOLUTION_DEG=1.0
